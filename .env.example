# Password untuk akses halaman admin (/admin)
ADMIN_PASSWORD=ganti-dengan-password-rahasia

# String acak minimal 32 karakter untuk HMAC signature cookie session admin
SESSION_SECRET=super-secret-random-key-minimal-32-karakter-panjangnya

# Token Vercel Blob (Otomatis terisi jika deploy ke Vercel dan hubungkan Vercel Blob store)
# Saat di localhost / dev tanpa token ini, data otomatis disimpan di folder .data/
# BLOB_READ_WRITE_TOKEN=

# URL website utama / portofolio utama Anda (opsional, untuk tombol "← Kembali ke Portfolio")
PUBLIC_MAIN_SITE_URL=https://domainkamu.com
PUBLIC_MAIN_SITE_LABEL=Portfolio Utama
PUBLIC_SITE_NAME=API Playground
