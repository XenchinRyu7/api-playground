---
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
const { title = 'API Playground' } = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' fill='%2309090b'/%3E%3Cpath d='M4 4l5 4-5 4' stroke='%2367e8f9' fill='none' stroke-width='2'/%3E%3C/svg%3E" />
  </head>
  <body class="bg-ink font-mono text-zinc-100 antialiased">
    <slot />
  </body>
</html>
