---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { SITE } from '../config';

interface Props { title?: string; description?: string; noindex?: boolean; bodyClass?: string }
const { title = SITE.name, description = SITE.description, noindex = false, bodyClass = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f2f2f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0c0e" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (() => {
        const mq = matchMedia('(prefers-color-scheme: dark)');
        const apply = (mode) => {
          const dark = mode === 'dark' || (mode !== 'light' && mq.matches);
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.dataset.theme = mode;
        };
        window.__theme = {
          get: () => localStorage.getItem('theme') || 'system',
          set: (mode) => { localStorage.setItem('theme', mode); apply(mode); dispatchEvent(new CustomEvent('themechange', { detail: mode })); },
        };
        apply(window.__theme.get());
        mq.addEventListener('change', () => apply(window.__theme.get()));
        addEventListener('load', () => requestAnimationFrame(() => document.documentElement.classList.add('theme-ready')));
      })();
    </script>
  </head>
  <body class={`bg-bg text-fg ${bodyClass}`}>
    <slot />
  </body>
</html>
