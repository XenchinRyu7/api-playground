{
  "openapi": "3.0.3",
  "info": { "title": "DummyJSON", "version": "1.0.0", "description": "Mock REST API untuk uji coba playground" },
  "servers": [{ "url": "https://dummyjson.com" }],
  "components": {
    "schemas": {
      "Login": {
        "type": "object",
        "properties": {
          "username": { "type": "string", "example": "emilys" },
          "password": { "type": "string", "example": "emilyspass" },
          "expiresInMins": { "type": "integer", "example": 30 }
        }
      },
      "NewUser": {
        "type": "object",
        "properties": {
          "firstName": { "type": "string", "example": "Ada" },
          "lastName": { "type": "string", "example": "Lovelace" },
          "age": { "type": "integer", "example": 36 }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Auth"], "operationId": "login", "summary": "Login dan ambil access token",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Login" } } } }
      }
    },
    "/auth/me": {
      "get": { "tags": ["Auth"], "operationId": "me", "summary": "Profil user yang sedang login", "security": [{ "bearer": [] }] }
    },
    "/users": {
      "get": {
        "tags": ["Users"], "operationId": "listUsers", "summary": "Daftar user",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 3 } },
          { "name": "skip", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "select", "in": "query", "schema": { "type": "string", "example": "firstName,age" } }
        ]
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["Users"], "operationId": "getUser", "summary": "Detail user",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 1 } }]
      },
      "delete": {
        "tags": ["Users"], "operationId": "deleteUser", "summary": "Hapus user (simulasi)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 1 } }]
      }
    },
    "/users/add": {
      "post": {
        "tags": ["Users"], "operationId": "addUser", "summary": "Tambah user (simulasi)",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewUser" } } } }
      }
    },
    "/products": {
      "get": {
        "tags": ["Data"], "operationId": "listProducts", "summary": "Daftar produk",
        "parameters": [{ "name": "limit", "in": "query", "schema": { "type": "integer", "default": 3 } }]
      }
    },
    "/products/search": {
      "get": {
        "tags": ["Data"], "operationId": "searchProducts", "summary": "Cari produk",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string", "example": "phone" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 3 } }
        ]
      }
    },
    "/quotes/random": { "get": { "tags": ["Data"], "operationId": "randomQuote", "summary": "Kutipan acak" } }
  }
}
