{
  "info": {
    "name": "JSONPlaceholder",
    "description": "Fake REST API gratis untuk testing & prototyping. Contoh koleksi **Postman v2.1** dengan folder, variabel, dan contoh response.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://jsonplaceholder.typicode.com" },
    { "key": "token", "value": "demo-token" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "item": [
    {
      "name": "Posts",
      "description": "Resource artikel blog.",
      "item": [
        {
          "name": "List posts",
          "request": {
            "method": "GET",
            "description": "Ambil daftar post. Gunakan `_limit` untuk membatasi jumlah dan `userId` untuk filter.",
            "url": {
              "raw": "{{baseUrl}}/posts?_limit=5&userId=1",
              "host": ["{{baseUrl}}"], "path": ["posts"],
              "query": [
                { "key": "_limit", "value": "5", "description": "Jumlah maksimal item" },
                { "key": "userId", "value": "1", "description": "Filter berdasarkan user", "disabled": true }
              ]
            }
          },
          "response": [
            {
              "name": "200 OK", "code": 200, "status": "OK",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "[\n  {\n    \"userId\": 1,\n    \"id\": 1,\n    \"title\": \"sunt aut facere repellat\",\n    \"body\": \"quia et suscipit...\"\n  }\n]"
            }
          ]
        },
        {
          "name": "Get post",
          "request": {
            "method": "GET",
            "description": "Detail satu post berdasarkan `id`.",
            "url": { "raw": "{{baseUrl}}/posts/:id", "host": ["{{baseUrl}}"], "path": ["posts", ":id"], "variable": [{ "key": "id", "value": "1", "description": "ID post" }] }
          },
          "response": [
            { "name": "200 OK", "code": 200, "status": "OK", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": "{\n  \"userId\": 1,\n  \"id\": 1,\n  \"title\": \"sunt aut facere repellat\",\n  \"body\": \"quia et suscipit...\"\n}" },
            { "name": "404 Not Found", "code": 404, "status": "Not Found", "header": [], "body": "{}" }
          ]
        },
        {
          "name": "Create post",
          "request": {
            "method": "POST",
            "description": "Buat post baru (disimulasikan, data tidak benar-benar tersimpan).",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Halo dunia\",\n  \"body\": \"Dikirim dari API Playground\",\n  \"userId\": 1\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] }
          },
          "response": [
            { "name": "201 Created", "code": 201, "status": "Created", "header": [], "body": "{\n  \"title\": \"Halo dunia\",\n  \"body\": \"Dikirim dari API Playground\",\n  \"userId\": 1,\n  \"id\": 101\n}" }
          ]
        },
        {
          "name": "Update post",
          "request": {
            "method": "PATCH",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Judul baru\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/posts/:id", "host": ["{{baseUrl}}"], "path": ["posts", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "Delete post",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/posts/:id", "host": ["{{baseUrl}}"], "path": ["posts", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": { "method": "GET", "url": "{{baseUrl}}/users" }
        },
        {
          "name": "User todos",
          "request": {
            "method": "GET",
            "description": "Nested resource: todos milik user.",
            "url": { "raw": "{{baseUrl}}/users/:userId/todos?completed=false", "host": ["{{baseUrl}}"], "path": ["users", ":userId", "todos"], "query": [{ "key": "completed", "value": "false" }], "variable": [{ "key": "userId", "value": "1" }] }
          }
        }
      ]
    },
    {
      "name": "Comments (form)",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Create comment (urlencoded)",
          "request": {
            "method": "POST",
            "body": { "mode": "urlencoded", "urlencoded": [{ "key": "postId", "value": "1" }, { "key": "name", "value": "Ada" }, { "key": "email", "value": "ada@example.com" }] },
            "url": "{{baseUrl}}/comments"
          }
        }
      ]
    }
  ]
}
