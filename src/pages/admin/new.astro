---
import Layout from '../../layouts/Layout.astro';
import AdminHeader from '../../components/AdminHeader.astro';
import { PALETTE } from '../../lib/util';
import { AVAILABLE_DEV_ICONS } from '../../lib/icons';
---
<Layout title="Import API · Admin" noindex>
  <AdminHeader title="Import API" subtitle="Postman Collection atau OpenAPI" />

  <main class="mx-auto max-w-4xl px-6 py-8">
    <div class="mb-6">
      <a href="/admin" class="text-xs text-muted hover:text-fg">← Kembali ke Dashboard</a>
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-fg">Upload Koleksi API</h1>
      <p class="mt-1 text-sm text-muted">Mendukung file Postman Collection v2.1 (.json) atau OpenAPI 3.0 / Swagger (.json).</p>
    </div>

    <!-- Step 1: Upload Dropzone -->
    <div class="card p-6 shadow-soft" id="drop-area">
      <div class="border-2 border-dashed border-line/20 rounded-xl p-8 text-center transition hover:border-accent hover:bg-accent/5 cursor-pointer" id="drop-zone">
        <input type="file" id="file-input" accept=".json,application/json" class="hidden" />
        <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-surface shadow-soft text-accent">
          <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
        </div>
        <h3 class="mt-4 font-semibold text-fg">Drag & Drop file JSON di sini</h3>
        <p class="mt-1 text-xs text-muted">atau klik untuk memilih file dari komputer</p>
        <span class="mt-3 inline-block rounded-full bg-line/10 px-3 py-1 font-mono text-[11px] text-muted">
          Format: Postman v2.1 / OpenAPI 3 / Swagger
        </span>
      </div>

      <div class="mt-4 flex items-center justify-between">
        <button type="button" id="toggle-paste-btn" class="text-xs text-accent hover:underline">
          Atau paste JSON langsung
        </button>
        <span id="file-name" class="font-mono text-xs text-muted"></span>
      </div>

      <div id="paste-box" class="hidden mt-4">
        <textarea id="paste-input" rows="8" placeholder="Paste konten JSON di sini..." class="field font-mono text-xs"></textarea>
        <div class="mt-2 flex justify-end">
          <button type="button" id="parse-paste-btn" class="btn btn-primary text-xs">Proses JSON</button>
        </div>
      </div>
    </div>

    <!-- Status & Warnings Banner -->
    <div id="status-box" class="hidden mt-6 card p-4"></div>

    <!-- Step 2: Form Metadata & Preview (shown after successful parse) -->
    <div id="form-container" class="hidden mt-6 card p-6 shadow-soft space-y-6">
      <div class="border-b border-line/10 pb-4 flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold text-fg">Konfigurasi Project</h2>
          <p class="text-xs text-muted">Sesuaikan tampilan kartu portofolio dan informasi project.</p>
        </div>
        <div class="badge font-mono uppercase" id="badge-source"></div>
      </div>

      <form id="save-project-form" class="space-y-5">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="mb-1 block text-xs font-medium text-muted">Nama Project *</label>
            <input type="text" id="proj-name" required class="field text-sm" />
          </div>
          <div>
            <label class="mb-1 block text-xs font-medium text-muted">Slug URL * (hanya huruf kecil, angka, minus)</label>
            <input type="text" id="proj-slug" required pattern="^[a-z0-9]+(?:-[a-z0-9]+)*$" class="field font-mono text-sm" />
          </div>
        </div>

        <div>
          <label class="mb-1 block text-xs font-medium text-muted">Tagline Singkat</label>
          <input type="text" id="proj-tagline" placeholder="Ringkasan 1 kalimat untuk ditampilkan di card" class="field text-sm" />
        </div>

        <div>
          <label class="mb-1 block text-xs font-medium text-muted">Deskripsi Lengkap</label>
          <textarea id="proj-desc" rows="3" class="field text-xs"></textarea>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div>
            <label class="mb-1 block text-xs font-medium text-muted">Developer Icon</label>
            <select id="proj-icon" class="field text-xs">
              {AVAILABLE_DEV_ICONS.map((ic) => (
                <option value={ic.id} selected={ic.id === 'code'}>{ic.label}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="mb-1 block text-xs font-medium text-muted">Warna Tema</label>
            <div class="flex items-center gap-2">
              <input type="color" id="proj-color" value="#0A84FF" class="h-9 w-12 cursor-pointer rounded border-0 bg-transparent p-0" />
              <div class="flex flex-wrap gap-1" id="palette-presets">
                {PALETTE.slice(0, 6).map((c) => (
                  <button type="button" class="h-5 w-5 rounded-full border border-black/20" style={`background-color: ${c}`} data-color={c}></button>
                ))}
              </div>
            </div>
          </div>
          <div>
            <label class="mb-1 block text-xs font-medium text-muted">Tags (pisahkan koma)</label>
            <input type="text" id="proj-tags" placeholder="auth, payment, crud" class="field text-xs" />
          </div>
        </div>

        <div class="flex items-center gap-6 border-t border-line/10 pt-4">
          <label class="flex items-center gap-2 cursor-pointer text-xs font-medium">
            <input type="checkbox" id="proj-published" checked class="check" />
            <span>Publikasikan (tampil di halaman utama)</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer text-xs font-medium">
            <input type="checkbox" id="proj-featured" class="check" />
            <span>Tandai sebagai Featured</span>
          </label>
        </div>

        <!-- Endpoints tree preview -->
        <div class="border-t border-line/10 pt-4">
          <h3 class="text-xs font-semibold text-muted mb-2">Endpoint Terdeteksi (<span id="ep-count">0</span>)</h3>
          <div id="endpoints-list" class="max-h-60 overflow-y-auto rounded-lg border border-line/10 bg-bg p-3 font-mono text-xs space-y-1"></div>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-line/10">
          <a href="/admin" class="btn btn-ghost text-xs">Batal</a>
          <button type="submit" id="save-btn" class="btn btn-primary text-xs">Simpan & Buat Project</button>
        </div>
      </form>
    </div>
  </main>
</Layout>

<script>
  import type { ImportResult, Item } from '../../lib/types';

  let currentImport: ImportResult | null = null;

  const dropZone = document.getElementById('drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileName = document.getElementById('file-name') as HTMLElement;
  const togglePasteBtn = document.getElementById('toggle-paste-btn') as HTMLButtonElement;
  const pasteBox = document.getElementById('paste-box') as HTMLDivElement;
  const pasteInput = document.getElementById('paste-input') as HTMLTextAreaElement;
  const parsePasteBtn = document.getElementById('parse-paste-btn') as HTMLButtonElement;
  const statusBox = document.getElementById('status-box') as HTMLDivElement;
  const formContainer = document.getElementById('form-container') as HTMLDivElement;
  const saveForm = document.getElementById('save-project-form') as HTMLFormElement;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;

  dropZone.addEventListener('click', () => fileInput.click());

  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-accent', 'bg-accent/10');
  });

  dropZone.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-accent', 'bg-accent/10');
  });

  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-accent', 'bg-accent/10');
    if (e.dataTransfer?.files.length) {
      handleFile(e.dataTransfer.files[0]);
    }
  });

  fileInput.addEventListener('change', () => {
    if (fileInput.files?.length) {
      handleFile(fileInput.files[0]);
    }
  });

  togglePasteBtn.addEventListener('click', () => {
    pasteBox.classList.toggle('hidden');
  });

  parsePasteBtn.addEventListener('click', () => {
    const text = pasteInput.value.trim();
    if (!text) return window.toast?.error('Paste konten JSON terlebih dahulu.');
    processJsonString(text, 'Manual Paste');
  });

  async function handleFile(file: File) {
    fileName.textContent = file.name;
    const text = await file.text();
    processJsonString(text, file.name);
  }

  async function processJsonString(content: string, name: string) {
    statusBox.classList.remove('hidden');
    statusBox.innerHTML = '<span class="text-xs text-muted">Memproses file JSON...</span>';
    formContainer.classList.add('hidden');

    try {
      const res = await fetch('/api/admin/preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: content,
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Gagal memproses file.');

      if (data.kind === 'environment') {
        statusBox.innerHTML = `<div class="rounded-lg bg-warn/10 p-3 text-xs text-warn border border-warn/20"><p class="font-semibold">[Notice] Postman Environment</p><p class="mt-0.5 text-muted">File ini berisi ${data.variables.length} variabel lingkungan. Silakan upload file Postman Collection atau OpenAPI utama terlebih dahulu.</p></div>`;
        return;
      }

      currentImport = data.result as ImportResult;
      showPreview(currentImport);
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Gagal memproses file.';
      statusBox.innerHTML = `<div class="rounded-lg bg-bad/10 p-3 text-xs text-bad border border-bad/20"><p class="font-semibold">[Error]</p><p class="mt-0.5">${msg}</p></div>`;
    }
  }

  function showPreview(result: ImportResult) {
    statusBox.innerHTML = `
      <div class="flex items-center gap-2 text-xs text-ok font-medium">
        <span class="rounded bg-ok/15 px-2 py-0.5 font-mono text-[10px] text-ok">SUCCESS</span>
        <span>Berhasil membaca koleksi</span>
        <span class="text-muted font-mono">(${result.endpointCount} endpoints)</span>
      </div>
      ${result.warnings?.length ? `<div class="mt-2 text-[11px] text-warn">${result.warnings.map((w: string) => `<div>• ${w}</div>`).join('')}</div>` : ''}
    `;

    (document.getElementById('badge-source') as HTMLElement).textContent = result.source;
    (document.getElementById('proj-name') as HTMLInputElement).value = result.name || '';
    (document.getElementById('proj-slug') as HTMLInputElement).value = slugify(result.name || '');
    (document.getElementById('proj-tagline') as HTMLInputElement).value = (result.description || '').split('\n')[0].slice(0, 100);
    (document.getElementById('proj-desc') as HTMLTextAreaElement).value = result.description || '';
    (document.getElementById('ep-count') as HTMLElement).textContent = String(result.endpointCount || 0);

    // Render endpoint items
    const epList = document.getElementById('endpoints-list') as HTMLDivElement;
    epList.innerHTML = '';
    const walk = (items: Item[]) => {
      items.forEach((it) => {
        if (it.kind === 'folder') {
          const div = document.createElement('div');
          div.className = 'font-semibold text-muted text-[11px] mt-2 mb-1 flex items-center gap-1.5';
          div.innerHTML = `<svg class="h-3.5 w-3.5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg> <span>${it.name}/</span>`;
          epList.appendChild(div);
          walk(it.items);
        } else {
          const div = document.createElement('div');
          div.className = 'flex items-center gap-2 py-0.5 text-[11px]';
          div.innerHTML = `<span class="verb v-${it.method.toLowerCase()} text-[9.5px]">${it.method}</span> <span class="truncate">${it.url || it.name}</span>`;
          epList.appendChild(div);
        }
      });
    };
    walk(result.items || []);

    formContainer.classList.remove('hidden');
    formContainer.scrollIntoView({ behavior: 'smooth' });
  }

  function slugify(text: string) {
    return text.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 48) || 'api';
  }

  document.querySelectorAll<HTMLButtonElement>('#palette-presets button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const color = btn.dataset.color;
      if (color) (document.getElementById('proj-color') as HTMLInputElement).value = color;
    });
  });

  saveForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!currentImport) return;

    saveBtn.disabled = true;
    saveBtn.textContent = 'Menyimpan...';

    const tags = ((document.getElementById('proj-tags') as HTMLInputElement).value || '')
      .split(',')
      .map((t) => t.trim().toLowerCase())
      .filter(Boolean);

    const payload = {
      importResult: currentImport,
      meta: {
        name: (document.getElementById('proj-name') as HTMLInputElement).value,
        slug: (document.getElementById('proj-slug') as HTMLInputElement).value,
        tagline: (document.getElementById('proj-tagline') as HTMLInputElement).value,
        description: (document.getElementById('proj-desc') as HTMLTextAreaElement).value,
        icon: (document.getElementById('proj-icon') as HTMLSelectElement).value || 'code',
        color: (document.getElementById('proj-color') as HTMLInputElement).value || '#0A84FF',
        tags,
        published: (document.getElementById('proj-published') as HTMLInputElement).checked,
        featured: (document.getElementById('proj-featured') as HTMLInputElement).checked,
      },
    };

    try {
      const res = await fetch('/api/admin/projects', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Gagal menyimpan.');

      window.toast?.success('Project berhasil dibuat! Mengalihkan...');
      setTimeout(() => {
        window.location.href = `/p/${data.project.slug}`;
      }, 500);
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Gagal menyimpan.';
      window.toast?.error(msg);
      saveBtn.disabled = false;
      saveBtn.textContent = 'Simpan & Buat Project';
    }
  });
</script>
